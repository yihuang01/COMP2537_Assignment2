<%- include('template/header') %>

    <h1>Users</h1>
    <% users.forEach(user=> { %>
        <div
            class="mb-3 p-3 border rounded d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

            <div>
                <strong>
                    <%= user.name %>
                </strong> (<%= user.user_type %>)
            </div>

            <div class="d-flex flex-wrap gap-2 p-2">
                <form method="POST" action="/admin/promote/<%= user._id %>" class="m-0">
                    <button class="btn btn-danger btn-sm rounded-pill px-3 py-2" type="submit">
                        Promote to Admin
                    </button>
                </form>

                <form method="POST" action="/admin/demote/<%= user._id %>" class="m-0">
                    <button class="btn btn-success btn-sm rounded-pill px-3 py-2" type="submit">
                        Demote to User
                    </button>
                </form>
            </div>

        </div>
        <% }); %>
            <%- include('template/footer') %>